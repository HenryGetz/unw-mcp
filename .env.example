# Copy to .env only if your MCP host reads dotenv files; export these instead by
# adding an "env" block to mcp.example.json. Never commit real values.

# Where the persistent browser profile and optional config live.
# UNW_MCP_CONFIG_DIR=/home/you/.config/unw-mcp
# UNW_MCP_CONFIG_FILE=/home/you/.config/unw-mcp/config.yaml
# UNW_MCP_PROFILE_DIR=/home/you/.config/unw-mcp/browser-profile

UNW_MCP_TIMEZONE=America/Chicago
UNW_MCP_HEADLESS=1

# Request / navigation budgets (milliseconds).
UNW_MCP_REQUEST_TIMEOUT_MS=30000
UNW_MCP_NAVIGATION_TIMEOUT_MS=90000
UNW_MCP_REAUTH_TIMEOUT_MS=30000

# Cache TTL overrides (minutes).
# UNW_MCP_DASHBOARD_TTL_MINUTES=5
# UNW_MCP_ANNOUNCEMENTS_TTL_MINUTES=2
# UNW_MCP_TASKS_TTL_MINUTES=2
# UNW_MCP_EVENTS_TTL_MINUTES=5
# UNW_MCP_QUICK_LINKS_TTL_MINUTES=10
# UNW_MCP_PROFILE_TTL_MINUTES=10
# UNW_MCP_DINING_TTL_MINUTES=60
# UNW_MCP_ACADEMIC_CALENDAR_TTL_MINUTES=360
# UNW_MCP_PAGES_TTL_MINUTES=1440
# UNW_MCP_PAGE_SEARCH_TTL_MINUTES=10
# UNW_MCP_SCHEDULE_TTL_MINUTES=10
# UNW_MCP_GRADES_TTL_MINUTES=30
# UNW_MCP_GPA_TTL_MINUTES=30
# UNW_MCP_HOLDS_TTL_MINUTES=5
# UNW_MCP_REGISTRATION_TTL_MINUTES=5
# UNW_MCP_TERMS_TTL_MINUTES=60
# UNW_MCP_BALANCES_TTL_MINUTES=5
# UNW_MCP_CHAPEL_TTL_MINUTES=15
# UNW_MCP_FINANCIAL_AID_TTL_MINUTES=60

{
  "name": "unw-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only, token-efficient MCP server for the University of Northwestern \u2013 St. Paul myUNW student portal",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "unw-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "config.example.yaml",
    "mcp.example.json",
    ".env.example",
    "docs/design.md",
    "docs/usage.md",
    "docs/portal-recon.md",
    "docs/usecase-eval.md",
    "docs/usecase-eval-2.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/dev/list-tools.mjs",
    "live-proof": "node scripts/dev/live-proof.mjs",
    "recon:login": "node scripts/recon/login.mjs",
    "recon:probe": "node scripts/recon/probe.mjs",
    "recon:session": "node scripts/recon/session.mjs",
    "recon:dining": "node scripts/recon/dining.mjs",
    "recon:calendar": "node scripts/recon/calendar.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.65.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
